# ---------------------------------------------------------------------------
# Copy this file to  server/.env  and fill in real values.
# server/.env is git-ignored - never commit real secrets.
# ---------------------------------------------------------------------------

# Local PostgreSQL connection string. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Matches the role + database created by db/00_create_role_and_db.sql:
DATABASE_URL=postgresql://chowly_app:chowly_dev_pw@localhost:5432/chowly

# Secret used to sign the session cookie that remembers your current role.
# Any long random string is fine for local dev.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the API server listens on (the Vite dev server proxies /api here).
PORT=3000

# "development" locally, "production" on the deployed host.
NODE_ENV=development
